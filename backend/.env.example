# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gramsetu?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/gramsetu

# JWT Authentication Secret (Use a 64+ char random string in production)
JWT_SECRET=gramsetu_production_jwt_secret_key_change_in_production_2026

# Cloudinary Cloud Storage Credentials (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Allowed Frontend Origins for CORS (Comma-separated for multiple origins)
CITIZEN_URL=http://localhost:3000,http://127.0.0.1:3000
ADMIN_URL=http://localhost:8080,http://127.0.0.1:8080

# Mobile OTP Verification Settings
# Options: development (returns OTP in response and logs to console) | production (sends via SMS gateway)
OTP_MODE=development
OTP_PROVIDER=console
OTP_API_KEY=
